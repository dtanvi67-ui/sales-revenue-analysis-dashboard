-- Create a Date table (Modeling > New table)
DateTable =
ADDCOLUMNS (
    CALENDAR ( MIN ( SalesData[OrderDate] ), MAX ( SalesData[OrderDate] ) ),
    "Year", YEAR ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
    "Quarter", "Q" & FORMAT ( [Date], "Q" )
)

-- Create relationship: DateTable[Date] -> SalesData[OrderDate]
-- Mark DateTable as the date table using DateTable[Date].

Total Revenue = SUM ( SalesData[Sales] )
Total Orders = DISTINCTCOUNT ( SalesData[OrderID] )
Total Quantity Sold = SUM ( SalesData[Quantity] )
Total Profit = SUM ( SalesData[Profit] )
Profit Margin % = DIVIDE ( [Total Profit], [Total Revenue], 0 )
Average Order Value = DIVIDE ( [Total Revenue], [Total Orders], 0 )
Total Customers = DISTINCTCOUNT ( SalesData[Customer] )
Average Discount % = AVERAGE ( SalesData[Discount] )
Revenue Previous Month = CALCULATE ( [Total Revenue], DATEADD ( DateTable[Date], -1, MONTH ) )
Revenue MoM Change % = DIVIDE ( [Total Revenue] - [Revenue Previous Month], [Revenue Previous Month], 0 )
Top Product Revenue = CALCULATE ( [Total Revenue], TOPN ( 1, ALL ( SalesData[Product] ), [Total Revenue], DESC ) )
